    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.19",
    "expo-asset": "~58.0.18",
    "expo-blur": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-location": "~58.0.19",
    "expo-sensors": "~58.0.4",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
