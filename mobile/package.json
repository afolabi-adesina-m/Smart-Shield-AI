    "babel-preset-expo": "~57.0.0",
    "expo": "^57",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.10.1",
