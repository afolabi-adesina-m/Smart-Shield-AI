# Leave this as the Render site, or delete the line. The app uses that host
# when the variable is missing, so the laptop's Flask server can stay off.
# EXPO_PUBLIC_API_URL is accepted as an alias of EXPO_PUBLIC_API_BASE.
# Point at a computer on your network only when you run Flask yourself:
# EXPO_PUBLIC_API_BASE=http://192.168.1.20:5050
EXPO_PUBLIC_API_BASE=https://smart-shield-ai.onrender.com
