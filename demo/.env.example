# Copy to demo/.env — none of these are required for the free OSM demo.
# The map reads upstream URLs from the environment so a public deploy
# does not depend on a hard-coded host.

# Listen address. 0.0.0.0 is required on Render, Railway, and Docker.
SMART_SHIELD_HOST=0.0.0.0

# Enterprise engine key. Leave this unset while the plaintext engine is still
# in the repo. After you encrypt, set it in the host's secret store.
# Never commit the value. Generate one with: python tools/protect.py keygen
# SMART_SHIELD_KEY=

# Local ports. On a host that sets PORT (Render, Railway, Hugging Face),
# PORT wins and these are ignored by the process entrypoint.
SMART_SHIELD_PORT=5050
SMART_SHIELD_MOBILE_PORT=5051

# Optional absolute links for the Desktop / Mobile buttons.
# Leave blank to use same-origin / and /mobile.
# SMART_SHIELD_DESKTOP_URL=https://your-demo.example/
# SMART_SHIELD_MOBILE_URL=https://your-demo.example/mobile

# Browser origins allowed to call /api/*. Empty uses the Render site plus
# localhost and Expo dev ports. * opts back into an open policy.
# Native Expo sends no Origin header and is not blocked by this list.
# ALLOWED_ORIGINS=https://smart-shield-ai.onrender.com,http://localhost:8081
# SMART_SHIELD_CORS_ORIGINS is used only when ALLOWED_ORIGINS is empty.

# Per-route cap for score, directions, road context, suggest, reverse,
# cameras, and the practice loop. /api/health is not capped.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MIN=120
# MAX_CONTENT_LENGTH=1048576

# Sign-in is off so teammates can demo without a password.
# Set AUTH_REQUIRED=true only after ADMIN_USER, ADMIN_PASSWORD_HASH, and
# AUTH_SECRET are set in the host's secret store. Never commit the password
# or the hash you generated for a real account.
# Hash a password with: ADMIN_PASSWORD='choose-one' python demo/hash_password.py
# AUTH_REQUIRED=false
# ADMIN_USER=
# ADMIN_PASSWORD_HASH=
# AUTH_SECRET=
# ADMIN_PASSWORD is accepted only at boot to print a hash, then it should be removed.

# Address autocomplete. photon is free and needs no key.
# nominatim, google, and mapbox are optional. Google and Mapbox fall back
# to Photon when the key is missing.
GEOCODE_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io/api/
# GOOGLE_PLACES_API_KEY=
# MAPBOX_ACCESS_TOKEN=

# Map tiles. The public map uses OpenStreetMap and does not need a key.
# Optional: a full tile URL template (and a night template). If either is set,
# the browser uses it and falls back to OpenStreetMap when tiles fail.
# MAP_TILE_URL=https://tile.example/{z}/{x}/{y}.png
# MAP_TILE_URL_DARK=
# MAP_TILE_ATTRIBUTION=© Example
# MAP_TILE_SUBDOMAINS=abcd
# MAP_TILE_MAX_ZOOM=19
# A public Mapbox token (pk.) is also optional and selects Mapbox light/dark
# styles. A secret token (sk.) is ignored for tiles and stays on the server.

# Upstream map services. No API key is required for the defaults.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSRM_URL=https://router.project-osrm.org/route/v1/driving
# Tried first; the app also falls back through other public Overpass servers.
OVERPASS_URL=https://overpass.openstreetmap.fr/api/interpreter
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
